# Gradle / 构建产物（APK 一律不入库，发布走 GitHub Release）
.gradle/
build/
app/build/
local.properties
.kotlin/

# 发布包：根目录也可能被手动放过一份，绝不能误入库
*.apk
*.aab
*.hprof
captures/
.cxx/

# R8 混淆映射（发版必须与对应版本一起归档，用于还原线上崩溃堆栈）。
# ⚠️ 绝不入库：mapping.txt 里是「混淆后类名 → 原始类名/方法名/行号」的全量对照表，
# 公开仓库等于把混淆形同虚设（40MB 量级，且会随版本不断增长）。
# 约定：仓库根留 `nba-live-<version>-mapping.txt` 本地归档，发布附件走 GitHub Release。
*-mapping.txt

# 签名凭据 —— 绝不入库
keystore.properties
*.jks
*.keystore

# IDE
.idea/
*.iml
.DS_Store

# 设计稿工具的依赖与中间产物
design/_shared/node_modules/
design/_shared/out/
design/_shared/out-selftest/
design/_shared/probe/
node_modules/

# 真机/模拟器测试截图（本地留存，不入库）
design/app-run/
build-shots/

# 调查期抓取的源站页面快照（仅供本地定位用，不入库）
.forensics/
